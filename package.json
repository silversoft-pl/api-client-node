  "repository": { "type": "git", "url": "git+https://github.com/silversoft-pl/api-client-node.git" },
  "bugs": { "url": "https://github.com/silversoft-pl/api-client-node/issues" },
  "keywords": ["api", "http", "client", "rfc9421", "http-signatures"],
